# 1 "/home/barth/zephyrproject/zephyr/boards/seeed/xiao_esp32c3/seeed_xiao_connector.dtsi" 1






/ {
 xiao_d: connector {
  compatible = "seeed,xiao-gpio";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpio0 2 0>,
      <1 0 &gpio0 3 0>,
      <2 0 &gpio0 4 0>,
      <3 0 &gpio0 5 0>,
      <4 0 &gpio0 6 0>,
      <5 0 &gpio0 7 0>,
      <6 0 &gpio0 21 0>,
      <7 0 &gpio0 20 0>,
      <8 0 &gpio0 8 0>,
      <9 0 &gpio0 9 0>,
      <10 0 &gpio0 10 0>;
 };
};

xiao_spi: &spi2 {};

xiao_i2c: &i2c0 {};

xiao_serial: &uart0 {};

xiao_adc: &adc0 {};
